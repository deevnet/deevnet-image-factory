{
  "_comment": "tenant2backend - where deevnet-log-user reads the store's users and writes vmauth's configuration, and the tenant's alerting (CHG-0072)",
  "base": "/etc/backend/log/base.json",
  "users_dir": "/etc/backend/log/users.d",
  "auth_file": "/etc/backend/log/auth/auth.yml",
  "reload_url": "http://127.0.0.1:8426/-/reload",
  "timeout_seconds": 10,
  "alerting": {
    "alerts_dir": "/etc/backend/log/alerts.d",
    "vmalert_dir": "/var/lib/backend/vmalert",
    "vmalert_binary": "/usr/local/bin/vmalert-prod",
    "vmalert_port_base": 20000,
    "alertmanager_file": "/etc/backend/alerting/alertmanager.yml",
    "alertmanager_reload_url": "http://127.0.0.1:9093/-/reload",
    "ntfy_url": "http://127.0.0.1:2586",
    "ntfy_config_file": "/etc/backend/alerting/ntfy-server.yml",
    "publisher_password_file": "/etc/backend/alerting/ntfy-publisher.pw",
    "publisher_password_path": "/etc/backend/alerting/ntfy-publisher.pw",
    "changed_file": "/var/lib/backend/vmalert/.changed"
  }
}
