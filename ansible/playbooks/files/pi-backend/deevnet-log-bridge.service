# tenant2backend - carries <tenant>/log/<device> from the broker into the
# tenant's device partition, (index, 2). The same binary as on Deevnet.
[Unit]
Description=deevnet-log-bridge, device logs from MQTT to the log store (tenant2backend)
ConditionPathExists=/etc/backend/log-bridge.env
After=backend-firstboot.service mosquitto.service vmauth.service
Wants=mosquitto.service vmauth.service

[Service]
DynamicUser=yes
EnvironmentFile=/etc/backend/log-bridge.env
ExecStart=/usr/local/bin/deevnet-log-bridge
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
