# tenant2backend - the tenant's alerting, written again from the card's state
# each boot, once Alertmanager and ntfy are up: the rule groups loaded with
# `tenant2backend alerts import`, and on a first boot the phone's ntfy login.
[Unit]
Description=tenant2backend alerting (the tenant's rules and the phone's login)
ConditionPathExists=/etc/backend/kit.json
Wants=alertmanager.service ntfy.service vmauth.service
After=alertmanager.service ntfy.service vmauth.service
# Up to two minutes of retries: vmauth counts as started when its process
# does, before it listens, and the writer's render ends by asking it to
# reload. On a first boot that came a moment too soon ("connection refused",
# CHG-0072 verification on a real Pi).
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/tenant2backend alerts sync
TimeoutStartSec=300
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
