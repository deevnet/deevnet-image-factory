# tenant2backend - the root file system fills its disk, on every boot (CHG-0074).
# The image's disk is 16G; a hypervisor may give it more, now or later.
[Unit]
Description=tenant2backend grow the root file system to its disk
After=local-fs.target
Before=backend-firstboot.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/backend-growroot

[Install]
WantedBy=multi-user.target
