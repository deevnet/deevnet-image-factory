# deevnet-kit - DHCP on the VM's network adapter (CHG-0074). Debian's nocloud
# image configures no network of its own. The MAC is the DHCP client ID, so a
# reservation on the owner's router holds. mDNS is avahi's, as on the Pi.
[Match]
Type=ether
Kind=!*

[Network]
DHCP=yes
MulticastDNS=no
LLMNR=no

[DHCPv4]
ClientIdentifier=mac
