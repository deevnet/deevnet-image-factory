#!/usr/bin/python3 -P
"""pve-creds - print the TF_VAR_proxmox_* exports for one hypervisor.

    eval "$(scripts/pve-creds dv02hyp002p02 dv02hyp002p02)"

The Proxmox API token that Packer templates and the tenant fabric's Terraform
use (Build-Time Secrets runbook), read from the hypervisor's host_vars in the
Deevnet inventory, the authoritative copy. Builds do not depend on OpenBao,
which is sealed outside work sessions (CHG-0037, ADR-0042).

The exports go to STDOUT ONLY, for the caller to eval into its own
environment: nothing is written to disk, and nothing is put on a command line
where `ps` or shell history would keep it.

Encrypted vault files are opened with ANSIBLE_VAULT_PASSWORD_FILE, or a prompt
on the terminal. Ansible's own libraries are used in-process, so nothing is
logged and templated values ({{ vault_... }}) resolve as they do in a play.
"""

import argparse
import getpass
import glob
import os
import shlex
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_INVENTORY = os.path.join(HERE, "..", "..", "ansible-inventory-deevnet", "mobile")
PVE_API_PORT = 8006


def die(msg):
    print(f"pve-creds: {msg}", file=sys.stderr)
    sys.exit(1)


def load_inventory(path):
    from ansible.inventory.manager import InventoryManager
    from ansible.parsing.dataloader import DataLoader
    from ansible.parsing.vault import VaultSecret
    from ansible.vars.manager import VariableManager

    loader = DataLoader()
    encrypted = [f for f in glob.glob(os.path.join(path, "**", "vault.yml"), recursive=True)
                 if open(f, "rb").read(14) == b"$ANSIBLE_VAULT"]
    if encrypted:
        pwfile = os.environ.get("ANSIBLE_VAULT_PASSWORD_FILE")
        if pwfile:
            pw = open(os.path.expanduser(pwfile)).read().strip()
        else:
            pw = getpass.getpass("Vault password: ", stream=sys.stderr)
        loader.set_vault_secrets([("default", VaultSecret(pw.encode()))])
    inv = InventoryManager(loader=loader, sources=[path])
    return loader, inv, VariableManager(loader=loader, inventory=inv)


def host_value(loader, inv, vm, host, name):
    from ansible.template import Templar

    h = inv.get_host(host)
    if h is None:
        die(f"{host} is not in the inventory")
    hv = vm.get_vars(host=h)
    if name not in hv:
        return ""
    return Templar(loader=loader, variables=hv).template(hv[name])


def from_inventory(loader, inv, vm, host):
    tid = host_value(loader, inv, vm, host, "proxmox_token_id")
    secret = host_value(loader, inv, vm, host, "proxmox_token_secret")
    addr = host_value(loader, inv, vm, host, "ansible_host") or host
    if not tid or not secret:
        die(f"{host} has no proxmox_token_id / proxmox_token_secret in the inventory "
            "(host_vars/<host>/vault.yml)")
    return {"url": f"https://{addr}:{PVE_API_PORT}/api2/json", "token_id": tid, "token_secret": secret}


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--inventory", default=os.environ.get("DEEVNET_INVENTORY", DEFAULT_INVENTORY))
    ap.add_argument("host", help="the hypervisor's inventory name")
    ap.add_argument("node", help="its Proxmox node name")
    a = ap.parse_args()
    if not os.path.isdir(a.inventory):
        die(f"inventory not found: {a.inventory} (set DEEVNET_INVENTORY)")

    loader, inv, vm = load_inventory(a.inventory)
    c = from_inventory(loader, inv, vm, a.host)

    q = shlex.quote
    print(f"export TF_VAR_proxmox_url={q(c['url'])}")
    print(f"export TF_VAR_proxmox_node={q(a.node)}")
    print(f"export TF_VAR_proxmox_token_id={q(c['token_id'])}")
    print(f"export TF_VAR_proxmox_token_secret={q(c['token_secret'])}")


if __name__ == "__main__":
    main()
